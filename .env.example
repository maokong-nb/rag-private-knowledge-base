# 复制为 .env 后填写。

# LLM（答案生成）：任意 OpenAI 兼容接口
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-在这里填你的key
LLM_MODEL=deepseek-chat

# Embedding：local=本地 bge-small-zh-v1.5（默认，免费离线）；api=OpenAI 兼容接口
EMBEDDING_BACKEND=local
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-v4

# Milvus：本地 milvus-lite 文件库（默认）或 Milvus / Zilliz Cloud 服务地址
MILVUS_URI=./data/milvus_rag.db
# MILVUS_URI=https://your-cluster.zillizcloud.com
# MILVUS_TOKEN=

# 切分与检索参数
CHUNK_SIZE=300
CHUNK_OVERLAP=50
TOP_K=4
SCORE_THRESHOLD=0.35
